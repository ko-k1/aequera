{
  "manifest_version": 2,
  "name": "Ad Veil",
  "version": "0.2.0",
  "description": "Aequera's ad and tracker handling: blocks requests the filter lists match and hides ads that reach the page. Local only.",
  "browser_specific_settings": {
    "gecko": {
      "id": "adveil@aequera"
    }
  },
  "icons": {
    "16": "icons/veil.svg",
    "32": "icons/veil.svg"
  },
  "permissions": [
    "<all_urls>",
    "storage",
    "unlimitedStorage",
    "tabs",
    "webNavigation",
    "webRequest",
    "webRequestBlocking"
  ],
  "background": {
    "scripts": ["model.js", "engine.js", "vault.js", "background.js"],
    "persistent": true
  },
  "page_action": {
    "default_icon": "icons/veil.svg",
    "default_title": "Ad Veil",
    "default_popup": "pages/popup.html",
    "show_matches": ["http://*/*", "https://*/*"],
    "pinned": true,
    "browser_style": false
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
