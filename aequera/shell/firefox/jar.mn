    content/browser/aequera/rail/aequera-rail.css              (rail/aequera-rail.css)
    content/browser/aequera/rail/aequera-essentials.css        (rail/aequera-essentials.css)
    content/browser/aequera/rail/drag-model.js                 (rail/drag-model.js)
    content/browser/aequera/rail/scroll-model.js               (rail/scroll-model.js)
    content/browser/aequera/rail/magnify-model.js              (rail/magnify-model.js)
    content/browser/aequera/rail/aequera-tabs.js               (rail/aequera-tabs.js)
    content/browser/aequera/rail/aequera-tabs-drag.js          (rail/aequera-tabs-drag.js)
    content/browser/aequera/rail/aequera-tabs.css              (rail/aequera-tabs.css)
    content/browser/aequera/workspaces/workspace-model.js      (workspaces/workspace-model.js)
    content/browser/aequera/workspaces/site-sort-model.js      (workspaces/site-sort-model.js)
    content/browser/aequera/workspaces/aequera-workspaces.js   (workspaces/aequera-workspaces.js)
    content/browser/aequera/workspaces/aequera-workspaces.css  (workspaces/aequera-workspaces.css)
    content/browser/aequera/command/command-model.js           (command/command-model.js)
    content/browser/aequera/command/aequera-command.js         (command/aequera-command.js)
    content/browser/aequera/command/aequera-urlbar.sys.mjs     (command/aequera-urlbar.sys.mjs)
    content/browser/aequera/bookmarks/aequera-bookmarks.js     (bookmarks/aequera-bookmarks.js)
    content/browser/aequera/bookmarks/aequera-bookmarks.css    (bookmarks/aequera-bookmarks.css)
    content/browser/aequera/notifications/aequera-notifications.css (notifications/aequera-notifications.css)
    content/browser/aequera/layout/aequera-layout.js           (layout/aequera-layout.js)
    content/browser/aequera/narrow/aequera-narrow.js           (narrow/aequera-narrow.js)
    content/browser/aequera/fullscreen/aequera-fullscreen.js   (fullscreen/aequera-fullscreen.js)
    content/browser/aequera/privacy/aequera-privacy.js         (privacy/aequera-privacy.js)
    content/browser/aequera/adveil/aequera-adveil.js           (adveil/aequera-adveil.js)
    content/browser/aequera/newtab/aequera-newtab.html         (newtab/aequera-newtab.html)
    content/browser/aequera/newtab/aequera-newtab.css          (newtab/aequera-newtab.css)
    content/browser/aequera/newtab/aequera-newtab.js           (newtab/aequera-newtab.js)
    content/browser/aequera/privatebrowsing/aequera-private.css (privatebrowsing/aequera-private.css)
    content/browser/aequera/incontent/aequera-in-content.css   (incontent/aequera-in-content.css)
# patches/toolkit/in-content has toolkit's common-shared.css import this
# toolkit-namespace URL; the shell provides it. Without the override (in
# Firefox) the import finds nothing and loads nothing.
% override chrome://global/skin/in-content/aequera-in-content.css chrome://browser/content/aequera/incontent/aequera-in-content.css
    content/browser/aequera/incontent/illustrations/default-yes.svg    (incontent/illustrations/default-yes.svg)
    content/browser/aequera/incontent/illustrations/default-no.svg     (incontent/illustrations/default-no.svg)
    content/browser/aequera/incontent/illustrations/celebrate.svg      (incontent/illustrations/celebrate.svg)
    content/browser/aequera/incontent/illustrations/lock.svg           (incontent/illustrations/lock.svg)
    content/browser/aequera/incontent/illustrations/mark.svg           (incontent/illustrations/mark.svg)
    content/browser/aequera/incontent/illustrations/ai.svg             (incontent/illustrations/ai.svg)
    content/browser/aequera/incontent/illustrations/no-connection.svg  (incontent/illustrations/no-connection.svg)
    content/browser/aequera/incontent/illustrations/security-error.svg (incontent/illustrations/security-error.svg)
    content/browser/aequera/incontent/illustrations/shield-check.svg   (incontent/illustrations/shield-check.svg)
    content/browser/aequera/incontent/illustrations/shield-alert.svg   (incontent/illustrations/shield-alert.svg)
# Firefox's mascot artwork (the fox, "Kit") and its violet brand shields are
# Firefox's identity, not Aequera's: the chrome registry serves Aequera's
# illustrations at the same URLs (and intrinsic sizes), so every page,
# shadow root, and test that names them keeps working. Product identity,
# like the branding: not pref-gated. Firefox's neutral illustrations
# (license, malformed URL, about:config's warning) are kept.
% override chrome://global/skin/illustrations/kit-happy.svg chrome://browser/content/aequera/incontent/illustrations/default-yes.svg
% override chrome://global/skin/illustrations/kit-concerned.svg chrome://browser/content/aequera/incontent/illustrations/default-no.svg
% override chrome://global/skin/illustrations/kit-confetti.svg chrome://browser/content/aequera/incontent/illustrations/celebrate.svg
% override chrome://global/skin/illustrations/kit-holding-lock.svg chrome://browser/content/aequera/incontent/illustrations/lock.svg
% override chrome://global/skin/illustrations/kit-in-circle.svg chrome://browser/content/aequera/incontent/illustrations/mark.svg
% override chrome://browser/skin/preferences/fox-ai.svg chrome://browser/content/aequera/incontent/illustrations/ai.svg
% override chrome://global/skin/illustrations/no-connection.svg chrome://browser/content/aequera/incontent/illustrations/no-connection.svg
% override chrome://global/skin/illustrations/security-error.svg chrome://browser/content/aequera/incontent/illustrations/security-error.svg
% override chrome://global/skin/illustrations/shield-check.svg chrome://browser/content/aequera/incontent/illustrations/shield-check.svg
% override chrome://global/skin/illustrations/shield-alert.svg chrome://browser/content/aequera/incontent/illustrations/shield-alert.svg
    content/browser/aequera/tor/tor-model.js                   (tor/tor-model.js)
    content/browser/aequera/tor/aequera-tor.js                 (tor/aequera-tor.js)
    content/browser/aequera/tor/aequera-tor.css                (tor/aequera-tor.css)
    content/browser/aequera/tor/aequera-tor-common.sys.mjs     (tor/aequera-tor-common.sys.mjs)
    content/browser/aequera/tor/aequera-tor-launch.sys.mjs     (tor/aequera-tor-launch.sys.mjs)
    content/browser/aequera/tor/aequera-tor-daemon.sys.mjs     (tor/aequera-tor-daemon.sys.mjs)
    content/browser/aequera/tor/tor.svg                        (tor/tor.svg)
