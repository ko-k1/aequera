# Generated Firefox tree
worktree/firefox/

# Managed upstream Firefox checkout (see docs/engineering/UPSTREAM1.md).
# Only upstream/manifests/* is committed; the checkout is reproduced by tooling.
upstream/firefox/

# Build outputs (root-level only; patches/build/ is committed source)
/build/
/obj-*/

# Local tooling/cache
.cache/

# Local agent-tool state (Serena MCP)
.serena/

# Local test/profile state
.tmp/

# Rust build artifacts
target/

# Python bytecode / caches (tooling only, never source)
__pycache__/
*.pyc
*.pyo

# Config migration backups (tools/cli config migrate writes *.bak next to source)
*.bak

# OS / editor noise (never source)
.DS_Store
*.swp
*.swo
.vscode/
