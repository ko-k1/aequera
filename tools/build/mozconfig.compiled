# Aequera compiled build (full C++/Rust + front end).
#
# Unlike mozconfig.artifact (Mozilla's prebuilt firefox.exe, minutes), this
# compiles everything: hours on first build, needs Visual Studio 2022 with
# C++ (see tools/bootstrap/windows.md). It is the only build that carries
# the Aequera binary identity end to end: aequera.exe with the Aequera
# icons embedded, registry keys, taskbar AUMID, and installer.
#
# Use from the MozillaBuild shell, inside worktree/firefox:
#   export MOZCONFIG=/c/src/aequera/tools/build/mozconfig.compiled
#
# The artifact build stays the default for shell/front-end work.

ac_add_options --enable-project=browser

# Keep build output inside the generated worktree, away from Aequera source.
# Separate from the artifact objdir so both builds can coexist.
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-aequera

# Cap parallelism: unrestrained -j OOMs clang-cl on shared machines (this
# box also runs ML training; even -j4 OOMs giant unified TUs + the gkrust
# LTO link against ~70GB resident training jobs, so serialize fully).
mk_add_options MOZ_MAKE_FLAGS="-j1"

# Rust toolchain: the tree needs >= 1.90.0, but newer rustc can crash on the
# gkrust LTO link (stable hit 0xc0000409 here). If so, point RUSTC/CARGO at
# an older toolchain (1.95.0 is known-good on this machine) in the shell
# that runs mach, e.g. export RUSTC=.../toolchains/1.95.0-.../bin/rustc.exe.

# Product identity and branding (shared with every Aequera mozconfig).
. "$topsrcdir/../../tools/build/mozconfig.branding"
# MOZ_APP_NAME defaults to the lowercased basename, "aequera": the binary
# and install names. (mozconfig.artifact pins "firefox", the name of the
# prebuilt binary it runs.)

# Mozilla's update and crash-report servers: an Aequera build must never
# update itself to Firefox or send crash reports to Mozilla. Compiled out
# here (the artifact build instead drops both servers from the launch ini,
# because the prebuilt binary has them compiled in).
ac_add_options --disable-updater
ac_add_options --disable-crashreporter
