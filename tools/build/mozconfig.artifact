# Aequera artifact build (front-end only).
#
# Downloads Mozilla's prebuilt compiled parts (C++/Rust) for the pinned
# revision and builds only JS/CSS/XHTML/prefs locally: minutes, no host C++
# toolchain beyond the bootstrap guides. Suits all shell work
# (aequera/shell, browser patches without C++). Any C++/Rust/Gecko patch
# needs a full build instead.
#
# Use from any POSIX shell (MozillaBuild on Windows, any terminal on
# Linux/macOS), inside worktree/firefox:
#   export MOZCONFIG="$PWD/../../tools/build/mozconfig.artifact" (repo-relative)

ac_add_options --enable-project=browser
ac_add_options --enable-artifact-builds

# Build output lives outside the generated worktree (obj/<worktree>/artifact
# at the repo root, gitignored): recreating the worktree on a new Firefox
# base keeps the objdir, and each worktree directory gets its own.
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/../../obj/$(basename "$topsrcdir")/artifact

# Host-platform tuning (parallelism, toolchain notes).
. "$topsrcdir/../../tools/build/mozconfig.platform"

# Product identity and branding (shared with every Aequera mozconfig).
. "$topsrcdir/../../tools/build/mozconfig.branding"
# The binary is Mozilla's prebuilt binary (firefox.exe on Windows, firefox on
# Linux, Firefox.app on macOS): keep the app name that names it (the Aequera
# basename would otherwise make it "aequera").
ac_add_options --with-app-name=firefox
