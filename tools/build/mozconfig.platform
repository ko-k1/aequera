# Aequera host-platform tuning, sourced by every Aequera build mozconfig.
#
# Firefox's own setup docs are authoritative per OS
# (https://firefox-source-docs.mozilla.org/setup/); the Aequera deltas for
# each host live in its own fragment, tools/build/<windows,macos,linux>/mozconfig,
# and this file only picks it. Values mirror tools/bootstrap/<os>.md.
case "$(uname -s)" in
MINGW*|MSYS*|CYGWIN*) . "$topsrcdir/../../tools/build/windows/mozconfig" ;;
Darwin) . "$topsrcdir/../../tools/build/macos/mozconfig" ;;
Linux) . "$topsrcdir/../../tools/build/linux/mozconfig" ;;
esac

# Rust toolchain (every host): the tree needs >= 1.90.0, but a newer rustc
# can crash on the gkrust LTO link (on Windows this surfaced as stable
# hitting 0xc0000409; 1.95.0 is known-good there). If so, point RUSTC/CARGO
# at an older toolchain in the shell that runs mach (a configure-time
# setting, so re-run ./mach configure after changing it); the per-OS
# fragments give the path layout.
