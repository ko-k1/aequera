# Patch files must keep LF endings: git apply matches them byte-for-byte
# against Firefox sources, and core.autocrlf would otherwise convert them.
*.patch text eol=lf
# Shell scripts run under bash (MozillaBuild/msys2), which rejects CRLF.
*.sh text eol=lf
# cmd.exe batch files need CRLF.
*.cmd text eol=crlf
# Linux desktop integration files are parsed by freedesktop/dbus tooling
# (desktop entry, D-Bus service, shell search provider): keep LF so a
# checkout installs byte-identical files on every OS.
aequera/design/branding/linux/** text eol=lf
# Overlays are copied verbatim into worktree/firefox/browser/aequera: CRLF
# would ship divergent bytes on Windows checkouts (core.autocrlf=true).
aequera/shell/** text eol=lf
# Branding overlays are also copied verbatim, but the tree mixes text and
# binary assets. Scope LF-only to text types; binaries are exempted below
# (later rules win). A broad `text` rule here strips 0D bytes from PNG
# magic (89 50 4E 47 0D 0A 1A 0A) and incidental 0D 0A pairs in ICO/ICNS/BMP.
aequera/design/branding/**/*.svg text eol=lf
aequera/design/branding/**/*.xml text eol=lf
aequera/design/branding/**/*.mn text eol=lf
aequera/design/branding/**/moz.build text eol=lf
aequera/design/branding/**/*.nsi text eol=lf
aequera/design/branding/**/*.md text eol=lf
# Declarative inputs must hash identically on every OS.
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.lock text eol=lf
*.json text eol=lf
*.js text eol=lf
*.css text eol=lf
*.ftl text eol=lf
*.properties text eol=lf
*.ini text eol=lf
*.desktop text eol=lf
*.service text eol=lf
# Binary assets must never undergo LF normalization. Placed last so they
# override any broad `text` rules above (later rules win).
*.png -text -diff
*.ico -text -diff
*.icns -text -diff
*.bmp -text -diff
*.jpg -text -diff
*.jpeg -text -diff
