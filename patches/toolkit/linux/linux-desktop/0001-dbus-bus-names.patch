       // so use G_BUS_NAME_OWNER_FLAGS_DO_NOT_QUEUE and quit.
       G_BUS_TYPE_SESSION, GetDBusBusName(), G_BUS_NAME_OWNER_FLAGS_DO_NOT_QUEUE,
       [](GDBusConnection* aConnection, const gchar*,
