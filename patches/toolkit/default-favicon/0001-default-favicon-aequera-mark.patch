+  <defs>
+    <g id="unit-sector">
+      <!--
+        Common construction:
+        - all long/short transitions use exact 30° / 90° / 150° directions
+        - block thickness = 50 source units
+        - the three copies are exact 120° rotations about (205,214)
+      -->
+
+      <!-- Outer blue face: 50-unit thickness, exact 30° side angle -->
+      <path fill="#4ED5FF"
+            d="M295 160
