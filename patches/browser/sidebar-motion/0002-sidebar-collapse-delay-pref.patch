Subject: [PATCH 2/3] sidebar: optional collapse delay for expand-on-hover

Why Firefox source must change:
  onMouseLeave collapses the launcher immediately. Aequera's hover model
  lingers 150ms before collapsing so a pointer grazing the edge does not
  whiplash the rail closed; there is no pref or hook for it.

What it changes:
  - New pref sidebar.animation.expand-on-hover.collapse-delay-ms (default 0:
    immediate, i.e. current Firefox behavior).
  - onMouseLeave schedules the collapse; onMouseEnter and any direct
    _collapseLauncher() call cancel a pending one. The timer re-checks the
    real pointer position before collapsing.

Depends on: nothing (series order only).
Validation: aequera shell tests (linger holds, re-enter cancels, delay 0 is
  immediate); upstream sidebar tests green under Firefox defaults.
Upstream risk: low; onMouseLeave/onMouseEnter/_collapseLauncher heads.

diff --git a/browser/components/sidebar/browser-sidebar.js b/browser/components/sidebar/browser-sidebar.js
index d0c84338e245..ca19f7251549 100644
--- a/browser/components/sidebar/browser-sidebar.js
+++ b/browser/components/sidebar/browser-sidebar.js
@@ -2603,6 +2603,7 @@ var SidebarController = {
   },
 
   _collapseLauncher() {
+    this._cancelScheduledCollapse();
     this.mouseEnterTask?.disarm();
     this._mouseEnterDeferred?.resolve();
     const contentArea = document.getElementById("tabbrowser-tabbox");
@@ -2640,10 +2641,38 @@ var SidebarController = {
     if (!this._state.launcherExpanded) {
       return;
     }
-    this._collapseLauncher();
+    this._scheduleCollapse();
+  },
+
+  /**
+   * Collapse after sidebar.animation.expand-on-hover.collapse-delay-ms, so a
+   * pointer grazing the launcher edge does not whiplash it closed. Re-entering
+   * cancels the pending collapse; 0 (the default) collapses immediately.
+   */
+  _scheduleCollapse() {
+    this._cancelScheduledCollapse();
+    const delay = this._animationExpandOnHoverCollapseDelayMs;
+    if (delay <= 0) {
+      this._collapseLauncher();
+      return;
+    }
+    this._collapseTimer = setTimeout(() => {
+      this._collapseTimer = null;
+      if (this._state.launcherExpanded && !this._checkIsHoveredOverLauncher()) {
+        this._collapseLauncher();
+      }
+    }, delay);
+  },
+
+  _cancelScheduledCollapse() {
+    if (this._collapseTimer) {
+      clearTimeout(this._collapseTimer);
+      this._collapseTimer = null;
+    }
   },
 
   onMouseEnter() {
+    this._cancelScheduledCollapse();
     if (this._state.launcherExpanded) {
       return;
     }
@@ -2909,6 +2938,12 @@ XPCOMUtils.defineLazyPreferenceGetter(
   "sidebar.animation.expand-on-hover.easing",
   DEFAULT_ANIMATION_EASING
 );
+XPCOMUtils.defineLazyPreferenceGetter(
+  SidebarController,
+  "_animationExpandOnHoverCollapseDelayMs",
+  "sidebar.animation.expand-on-hover.collapse-delay-ms",
+  0
+);
 XPCOMUtils.defineLazyPreferenceGetter(
   SidebarController,
   "_animationExpandOnHoverDelayDurationMs",
