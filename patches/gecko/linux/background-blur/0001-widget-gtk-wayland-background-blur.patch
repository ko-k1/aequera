+// Removes the pixels outside the rounded corners of aRect from aRegion.
+static void SubtractRoundedCorners(IntRegion& aRegion, const IntRect& aRect,
+                                   int32_t aRadius, bool aBottomCorners) {
+  const int32_t radius = std::min({aRadius, aRect.width / 2, aRect.height / 2});
+  for (int32_t row = 0; row < radius; row++) {
+    const double dy = radius - row - 0.5;
+    const int32_t inset =
+        radius - int32_t(std::lround(std::sqrt(radius * radius - dy * dy)));
+    if (inset <= 0) {
+      continue;
+    }
+    aRegion.SubOut(IntRect(aRect.x, aRect.y + row, inset, 1));
+    aRegion.SubOut(IntRect(aRect.XMost() - inset, aRect.y + row, inset, 1));
+    if (aBottomCorners) {
+      aRegion.SubOut(IntRect(aRect.x, aRect.YMost() - 1 - row, inset, 1));
+      aRegion.SubOut(
+          IntRect(aRect.XMost() - inset, aRect.YMost() - 1 - row, inset, 1));
+    }
+  }
+}
+
+void nsWindowWayland::UpdateBackgroundBlur() {
+  if (mWindowType != WindowType::TopLevel || !mIsMapped || !mGdkWindow) {
+    return;
+  }
+  nsWaylandDisplay* display = WaylandDisplayGet();
+  if (!StaticPrefs::widget_wayland_background_blur_enabled() ||
+      !display->IsBackgroundBlurSupported() || !mCompositedScreen) {
+    ClearBackgroundBlur(/* aCommit */ true);
+    return;
+  }
+  GdkWindow* toplevel = GetToplevelGdkWindow();
+  wl_surface* surface =
+      toplevel ? gdk_wayland_window_get_wl_surface(toplevel) : nullptr;
+  if (!surface) {
+    return;
+  }
+
+  // The client area sits inside the toplevel surface, offset by the
+  // client-side decoration margins. KWin (6.7) reads the region relative to
+  // the window geometry instead, which starts at the client area.
+  GdkPoint offset{0, 0};
+  if (!IsKdeDesktopEnvironment()) {
+    gdk_window_get_position(mGdkWindow, &offset.x, &offset.y);
+  }
+  const IntRect client(offset.x, offset.y, gdk_window_get_width(mGdkWindow),
+                       gdk_window_get_height(mGdkWindow));
+  IntRegion region(client);
+  const LayoutDeviceIntRect clientArea(LayoutDeviceIntPoint(), GetClientSize());
+  const LayoutDeviceIntRegion opaque = GetOpaqueRegion();
+  for (auto iter = opaque.RectIter(); !iter.Done(); iter.Next()) {
+    const auto rect = iter.Get().Intersect(clientArea);
+    if (rect.IsEmpty()) {
+      continue;
+    }
+    const GdkRectangle gdkRect = DevicePixelsToGdkRectRoundIn(rect);
+    region.SubOut(IntRect(gdkRect.x + offset.x, gdkRect.y + offset.y,
+                          gdkRect.width, gdkRect.height));
+  }
+  if (DoDrawTilebarCorners()) {
+    SubtractRoundedCorners(
+        region, client, LookAndFeel::GetInt(LookAndFeel::IntID::TitlebarRadius),
+        StaticPrefs::widget_gtk_rounded_bottom_corners_enabled());
+  }
+
+  if (mBackgroundBlur.mEffect && mBackgroundBlur.mSurface == surface &&
+      mBackgroundBlur.mRegion == region) {
+    return;
+  }
+  if (mBackgroundBlur.mSurface != surface) {
+    ClearBackgroundBlur(/* aCommit */ false);
+    mBackgroundBlur.mEffect =
+        ext_background_effect_manager_v1_get_background_effect(
+            display->GetBackgroundEffectManager(), surface);
+    mBackgroundBlur.mSurface = surface;
+  }
+  mBackgroundBlur.mRegion = region;
+
+  LOG("nsWindowWayland::UpdateBackgroundBlur() %u rects", region.GetNumRects());
+  wl_region* blurRegion = nullptr;
+  if (!region.IsEmpty()) {
+    blurRegion = wl_compositor_create_region(display->GetCompositor());
+    for (auto iter = region.RectIter(); !iter.Done(); iter.Next()) {
+      const IntRect& rect = iter.Get();
+      wl_region_add(blurRegion, rect.x, rect.y, rect.width, rect.height);
+    }
+  }
+  ext_background_effect_surface_v1_set_blur_region(mBackgroundBlur.mEffect,
+                                                   blurRegion);
+  if (blurRegion) {
+    wl_region_destroy(blurRegion);
+  }
+  // The blur region is double-buffered state of GTK's toplevel surface, which
+  // GTK commits only when it repaints the decorations.
+  wl_surface_commit(surface);
+}
+
+void nsWindowWayland::ClearBackgroundBlur(bool aCommit) {
+  if (!mBackgroundBlur.mEffect) {
+    return;
+  }
+  LOG("nsWindowWayland::ClearBackgroundBlur()");
+  MozClearPointer(mBackgroundBlur.mEffect,
+                  ext_background_effect_surface_v1_destroy);
+  if (aCommit) {
+    wl_surface_commit(mBackgroundBlur.mSurface);
+  }
+  mBackgroundBlur.mSurface = nullptr;
+  mBackgroundBlur.mRegion.SetEmpty();
+}
